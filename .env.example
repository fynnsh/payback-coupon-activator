# Intervall zwischen Aktivierungen (in Stunden)
SCHEDULE_INTERVAL_HOURS=24

# Pause zwischen einzelnen Coupon-Klicks (in Sekunden)
COOLDOWN_SECONDS=1

# Browser ohne GUI starten (true für VPS/Docker)
HEADLESS=true

# Rate-Limit: Anzahl Coupons vor Pause
RATE_LIMIT_BATCH_SIZE=100

# Rate-Limit: Dauer der Pause (in Stunden, z.B. 0.5 für 30 Min)
RATE_LIMIT_PAUSE_HOURS=1

# Web UI Port
WEB_PORT=8080

# Zeitzone (wichtig für VPS)
TZ=Europe/Berlin
